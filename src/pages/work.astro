['2026','CoherenceBench','Exploratory evaluation of whether agents stay decisionally coherent over long-running sessions.',[['GitHub','https://github.com/Venkat-RJ/coherencebench']]],
['2026','FACET','Probes for how faithfully models explain multi-factor decisions.',[['GitHub','https://github.com/Venkat-RJ/facet-benchmark']]],
['2026','Razorpay integration for Claude Code','Open-source skills and agent workflows covering checkout, subscriptions, webhooks and reconciliation.',[['GitHub','https://github.com/Venkat-RJ/razorpay-integration-plugin']]],
