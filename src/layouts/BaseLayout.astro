---
import '../styles/global.css';
import TopNav from '../components/TopNav.astro';
interface Props { title?: string; description?: string; }
const { title='Venkateshwar Jambula', description='AI engineer and technical leader. Former founder. Work across embedded systems, industrial ML, Bixby, enterprise GenAI and reliable agents.' } = Astro.props;
const site=Astro.site?.toString().replace(/\/$/,'') ?? 'https://venkat-rj.github.io';
const canonical=new URL(Astro.url.pathname,site).toString();
const ogImage=site+'/og-image.png';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content={description}/><meta name="theme-color" content="#fbfbf7"/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title}</title>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Venkateshwar Jambula"/><meta property="og:image" content={ogImage}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/>
</head>
<body><TopNav/><main class="site-main"><slot/></main>
<footer class="site-footer"><div><p class="footer-name">Venkateshwar Jambula</p><p>Bengaluru, India · AI systems, research, engineering.</p></div><div class="footer-links"><a href="mailto:venkateshwar.jambula@gmail.com">email</a><a href="https://github.com/Venkat-RJ" target="_blank" rel="noopener">github</a><a href="https://www.linkedin.com/in/venkateshwar-jambula/" target="_blank" rel="noopener">linkedin</a></div></footer>
</body></html>