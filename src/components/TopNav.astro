---
const pathname=Astro.url.pathname.replace(/\/$/,'')||'/';
const links=[{href:'/work',label:'work'},{href:'/notes',label:'notes'},{href:'/about',label:'about'},{href:'/now',label:'now'}];
const active=(href:string)=>pathname===href||pathname.startsWith(href+'/');
---
<nav class="topnav" aria-label="Primary"><div class="nav-inner"><a class="site-name" href="/">Venkat<span>.</span></a><ul class="nav-links">{links.map(link=><li><a href={link.href} aria-current={active(link.href)?'page':undefined}>{link.label}</a></li>)}</ul></div></nav>