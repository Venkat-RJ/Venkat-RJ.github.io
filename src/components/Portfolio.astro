---
import '@fontsource-variable/inter/index.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';

const experience = [
  {
    company: 'Sigmoid',
    role: 'Principal Data Scientist · GenAI',
    dates: '2024 — 2025',
    summary: 'Built enterprise GenAI systems and helped turn applied AI work into business outcomes.',
    points: [
      'Built Data Companion, an enterprise Text2SQL accelerator using Claude on AWS Bedrock and Snowflake, reaching 90% query accuracy.',
      'Built the winning GenAI recommendation prototype in a competitive client hackathon, helping secure a $1.5M contract.',
      'Established the GenAI Center of Excellence and upskilled 50+ engineers.'
    ]
  },
  {
    company: 'Samsung Research',
    role: 'Chief Data Scientist · Bixby',
    dates: '2022 — 2023',
    summary: 'Led applied AI work around Bixby intelligence, failure analysis and production reliability.',
    points: [
      'Led data scientists and PhD researchers working on Bixby intelligence, anomaly detection and out-of-domain requests.',
      'Built systems connecting customer feedback with server logs to help developers identify root causes.',
      'Co-inventor on Indian patent application 202341080390, filed in 2023.'
    ]
  },
  {
    company: 'Continental',
    role: 'Lead Data Scientist',
    dates: '2017 — 2022',
    summary: 'Built a data-science team and shipped optimization and industrial ML into engineering workflows.',
    points: [
      'Built and led a 12-person data science team across industrial ML, optimization and supply-chain applications.',
      'Reduced AntiPinch algorithm tuning from three weeks to 1.5 hours using Bayesian optimization.',
      'Delivered entity deduplication, demand forecasting and supplier-selection systems.'
    ]
  }
];

const research = [
  {
    name: 'CoherenceBench',
    eyebrow: 'Agent evaluation',
    description: 'Exploratory evaluation of decision coherence in long-running agents.',
    repo: 'coherencebench',
    marker: '01'
  },
  {
    name: 'FACET',
    eyebrow: 'Interpretability',
    description: 'Probes into how faithfully models explain multi-factor decisions.',
    repo: 'facet-benchmark',
    marker: '02'
  },
  {
    name: 'Razorpay for Claude Code',
    eyebrow: 'Open source',
    description: 'Skills for checkout, subscriptions, webhooks and reconciliation.',
    repo: 'razorpay-integration-plugin',
    marker: '03'
  },
  {
    name: 'Autoresearch on Apple Silicon',
    eyebrow: 'Research tooling',
    description: 'An adaptation of the autoresearch workflow for MPS, CPU and CUDA.',
    repo: 'autoresearch-mac-mini',
    marker: '04'
  }
];

const trajectory = [
  ['2011', 'Embedded systems', 'Bosch + Caterpillar', 'Control software, diagnostics, optimization and computer vision in constrained engineering environments.'],
  ['2017', 'Industrial AI', 'Continental', 'Machine learning and optimization moved from experiments into real engineering and supply-chain workflows.'],
  ['2022', 'AI leadership', 'Samsung + Sigmoid', 'Led teams, built Bixby intelligence systems, enterprise GenAI accelerators and internal AI capability.'],
  ['2025', 'Founder + research', 'PranaAlpha', 'Built agent products, knowledge infrastructure and evaluation work from first principles.']
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f2" />
    <title>Venkateshwar Jambula | AI Engineering Leader, Researcher &amp; Founder</title>
    <meta
      name="description"
      content="AI engineering leader, researcher and founder with 15 years across embedded systems, industrial ML, Samsung Bixby, enterprise GenAI and agent systems."
    />
    <link rel="icon" href="/favicon.svg" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <a class="brand" href="#main" aria-label="Venkateshwar Jambula home">
        <span class="brand-mark">VJ</span>
        <span class="brand-dot">.</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#research">Research</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <p class="kicker">AI engineering · research · systems</p>
          <h1>
            From embedded systems
            <span>to intelligent agents.</span>
          </h1>
          <p class="hero-lede">
            I build AI systems that have to work in the real world. Over 15 years,
            I have moved from safety-critical software and optimization to industrial
            ML, Bixby intelligence, enterprise GenAI, founder-built agents and
            reliability research.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="mailto:venkateshwar.jambula@gmail.com">Start a conversation</a>
            <a class="button button-ghost" href="https://github.com/Venkat-RJ" target="_blank" rel="noopener">GitHub <span>↗</span></a>
            <a class="button button-ghost" href="https://www.linkedin.com/in/venkateshwar-jambula/" target="_blank" rel="noopener">LinkedIn <span>↗</span></a>
          </div>

          <p class="availability">
            <span class="status-dot" aria-hidden="true"></span>
            Open to AI leadership, founding engineer and applied research roles.
          </p>
        </div>

        <aside class="identity-card" aria-label="Profile summary">
          <div class="photo-wrap">
            <img src="/headshot-src.jpg" alt="Venkateshwar Jambula" width="420" height="500" />
            <span class="photo-index">01 / VENKAT</span>
          </div>

          <div class="identity-meta">
            <p class="identity-name">Venkateshwar Jambula</p>
            <p>Builder · researcher · founder</p>
            <div class="identity-rule"></div>
            <div class="identity-row">
              <span>Base</span>
              <strong>Bengaluru, India</strong>
            </div>
            <div class="identity-row">
              <span>Arc</span>
              <strong>Systems → AI → agents</strong>
            </div>
          </div>
        </aside>
      </section>

      <section class="proof-strip" aria-label="Selected outcomes">
        <div class="proof-item">
          <strong>15</strong>
          <span>years across systems, ML and AI</span>
        </div>
        <div class="proof-item">
          <strong>12</strong>
          <span>person data-science team built</span>
        </div>
        <div class="proof-item">
          <strong>$1.5M</strong>
          <span>client contract helped secure</span>
        </div>
        <div class="proof-item">
          <strong>3 wks → 1.5 hrs</strong>
          <span>engineering optimization cycle</span>
        </div>
      </section>

      <section class="section trajectory" aria-labelledby="trajectory-title">
        <div class="section-heading">
          <div>
            <p class="section-label">Trajectory</p>
            <h2 id="trajectory-title">One technical thread, four chapters.</h2>
          </div>
          <p class="section-intro">
            The domains changed. The pattern did not: understand the system deeply,
            reduce uncertainty, then make it work reliably outside the demo.
          </p>
        </div>

        <div class="trajectory-grid">
          {trajectory.map(([year, title, place, description], index) => (
            <article class="trajectory-card">
              <div class="trajectory-top">
                <span class="trajectory-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="trajectory-year">{year}</span>
              </div>
              <h3>{title}</h3>
              <p class="trajectory-place">{place}</p>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="section-label">Selected work</p>
            <h2 id="work-title">Things I built when the answer was not obvious.</h2>
          </div>
          <p class="section-intro">
            Products and research prototypes from the founder chapter, where I owned
            product discovery, architecture, implementation and operations.
          </p>
        </div>

        <div class="work-grid">
          <article class="project project-large">
            <div class="project-head">
              <span class="project-index">A</span>
              <span class="project-state">Research prototype · 2026</span>
            </div>
            <div>
              <p class="project-eyebrow">Knowledge infrastructure</p>
              <h3>Lokaah</h3>
              <p class="project-summary">
                A source-grounded entity and relationship layer for agents working
                across fragmented public records.
              </p>
            </div>
            <div class="project-metrics">
              <div><strong>145,776</strong><span>entities</span></div>
              <div><strong>2.16M+</strong><span>relationships</span></div>
              <div><strong>MCP + REST</strong><span>interfaces</span></div>
            </div>
            <ul>
              <li>Built ingestion and OCR pipelines, cross-source entity resolution and source-cited graph relationships.</li>
              <li>Designed the system around traceability rather than answer-only retrieval.</li>
            </ul>
          </article>

          <article class="project">
            <div class="project-head">
              <span class="project-index">B</span>
              <span class="project-state">Built &amp; operated · 2025 — 2026</span>
            </div>
            <div>
              <p class="project-eyebrow">Agentic product</p>
              <h3>PortoAI</h3>
              <p class="project-summary">
                A broker-connected AI companion combining research, portfolio analysis,
                risk and trading workflows.
              </p>
            </div>
            <div class="project-metrics project-metrics-compact">
              <div><strong>14</strong><span>specialist agents</span></div>
              <div><strong>Human approval</strong><span>for execution</span></div>
            </div>
            <ul>
              <li>Designed tool calling, persistent context, evaluations and safety guardrails.</li>
              <li>Operated the product with real users before closing the company chapter.</li>
            </ul>
          </article>

          <article class="project project-note">
            <div class="project-head">
              <span class="project-index">C</span>
              <span class="project-state">Experiments</span>
            </div>
            <p class="project-eyebrow">What the experiments taught me</p>
            <h3>Reliability became the real problem.</h3>
            <p class="project-summary">
              Across an AI hedge-fund MVP, AdvisorsDesk and ZenTrader, the recurring
              failures were not just model quality. They were memory drift, inconsistent
              theses, weak provenance and brittle handoffs between agents and tools.
            </p>
            <p class="project-callout">
              That is what pushed my research toward agent reliability, evaluation,
              verifiable answers and formal methods.
            </p>
          </article>
        </div>
      </section>

      <section class="section research-section" id="research" aria-labelledby="research-title">
        <div class="section-heading">
          <div>
            <p class="section-label">Research &amp; open source</p>
            <h2 id="research-title">Public work you can inspect.</h2>
          </div>
          <p class="section-intro">
            Current interests: long-running agent reliability, formal verification,
            faithful reasoning, evaluation and research tooling.
          </p>
        </div>

        <div class="research-grid">
          {research.map((item) => (
            <a class="research-card" href={'https://github.com/Venkat-RJ/' + item.repo} target="_blank" rel="noopener">
              <div class="research-top">
                <span>{item.marker}</span>
                <span>↗</span>
              </div>
              <p class="research-eyebrow">{item.eyebrow}</p>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
            </a>
          ))}
        </div>
        <p class="research-note">
          Benchmark projects are exploratory work, not peer-reviewed findings.
        </p>
      </section>

      <section class="section" id="experience" aria-labelledby="experience-title">
        <div class="section-heading">
          <div>
            <p class="section-label">Industry experience</p>
            <h2 id="experience-title">Built inside large systems. Then built from zero.</h2>
          </div>
          <p class="section-intro">
            Engineering depth, team leadership and product execution across industrial,
            consumer and enterprise AI.
          </p>
        </div>

        <div class="experience-list">
          {experience.map((job) => (
            <article class="experience-row">
              <div class="experience-meta">
                <p class="experience-dates">{job.dates}</p>
                <h3>{job.company}</h3>
                <p>{job.role}</p>
              </div>
              <div class="experience-content">
                <p class="experience-summary">{job.summary}</p>
                <ul>
                  {job.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </article>
          ))}

          <article class="experience-row earlier-row">
            <div class="experience-meta">
              <p class="experience-dates">2011 — 2017</p>
              <h3>Systems foundation</h3>
              <p>Bosch + Caterpillar</p>
            </div>
            <div class="experience-content early-grid">
              <div>
                <strong>Senior Embedded Systems Engineer · Caterpillar</strong>
                <p>Computer vision for PCB inspection and genetic algorithms for injector optimization.</p>
              </div>
              <div>
                <strong>Senior Software Engineer · Bosch</strong>
                <p>Engine and exhaust control software, diagnostics and international project coordination.</p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="now-card" aria-labelledby="now-title">
        <div>
          <p class="section-label">Now</p>
          <h2 id="now-title">Going deeper on reliable AI systems.</h2>
        </div>
        <p>
          I am spending this phase contributing publicly, studying formal verification
          and long-running agents, and looking for a team where deep technical work
          and real product responsibility meet.
        </p>
        <a href="/now">What I’m doing now <span>→</span></a>
      </section>

      <footer id="contact">
        <div class="footer-copy">
          <p class="section-label">Contact</p>
          <h2>Build something difficult with me.</h2>
          <p>
            AI leadership, founding engineer, research engineering and applied AI roles.
          </p>
        </div>
        <div class="footer-actions">
          <a class="footer-email" href="mailto:venkateshwar.jambula@gmail.com">venkateshwar.jambula@gmail.com</a>
          <div class="footer-links">
            <a href="https://github.com/Venkat-RJ" target="_blank" rel="noopener">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/venkateshwar-jambula/" target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </div>
        <div class="footer-base">
          <span>Venkateshwar Jambula</span>
          <span>Bengaluru, India · 2026</span>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f7f2;
    --surface: #ffffff;
    --surface-soft: #f0f3ed;
    --ink: #132019;
    --ink-strong: #08130d;
    --muted: #657069;
    --faint: #98a199;
    --line: #dce2dc;
    --line-strong: #bdc8bf;
    --accent: #1e6b4f;
    --accent-soft: #dcebe4;
    --serif: 'Instrument Serif', Georgia, serif;
    --sans: 'Inter Variable', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --max: 1180px;
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 92px;
    background: var(--bg);
  }

  body {
    margin: 0;
    color: var(--ink);
    background:
      linear-gradient(rgba(19, 32, 25, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(19, 32, 25, 0.028) 1px, transparent 1px),
      var(--bg);
    background-size: 36px 36px;
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a { color: inherit; text-decoration: none; }
  p, h1, h2, h3 { margin: 0; }
  ul { margin: 0; }
  ::selection { background: var(--accent-soft); color: var(--ink-strong); }

  .skip {
    position: fixed;
    z-index: 100;
    top: -60px;
    left: 20px;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
  }
  .skip:focus { top: 16px; }

  .topbar {
    position: sticky;
    z-index: 20;
    top: 0;
    width: min(calc(100% - 48px), var(--max));
    height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(189, 200, 191, 0.75);
    background: rgba(247, 247, 242, 0.88);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    font-weight: 760;
    font-size: 19px;
    letter-spacing: -0.04em;
  }
  .brand-dot { color: var(--accent); }
  .topbar nav { display: flex; gap: 28px; }
  .topbar nav a {
    position: relative;
    color: var(--muted);
    font-size: 12px;
    font-weight: 560;
    letter-spacing: 0.04em;
  }
  .topbar nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -7px;
    height: 1px;
    background: var(--accent);
    transition: right 180ms ease;
  }
  .topbar nav a:hover { color: var(--ink-strong); }
  .topbar nav a:hover::after { right: 0; }

  main {
    width: min(calc(100% - 48px), var(--max));
    margin: 0 auto;
  }

  .hero {
    min-height: 690px;
    padding: 86px 0 72px;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(310px, 0.72fr);
    gap: clamp(58px, 8vw, 112px);
    align-items: center;
  }

  .kicker,
  .section-label {
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 780px;
    margin-top: 20px;
    font-family: var(--serif);
    color: var(--ink-strong);
    font-size: clamp(62px, 7.6vw, 108px);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.048em;
  }

  .hero h1 span {
    display: block;
    color: var(--accent);
    font-style: italic;
  }

  .hero-lede {
    max-width: 730px;
    margin-top: 34px;
    color: #455149;
    font-size: clamp(17px, 1.65vw, 21px);
    line-height: 1.62;
    letter-spacing: -0.015em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
  }

  .button {
    min-height: 44px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    color: var(--ink);
    font-size: 12px;
    font-weight: 650;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
    border-color: #95a69a;
    background: var(--surface);
  }

  .button-primary {
    border-color: var(--ink-strong);
    background: var(--ink-strong);
    color: white;
  }
  .button-primary:hover {
    border-color: var(--accent);
    background: var(--accent);
  }

  .availability {
    margin-top: 24px;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font-size: 12px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(30, 107, 79, 0.10);
  }

  .identity-card {
    position: relative;
    padding: 12px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 24px 70px rgba(32, 54, 42, 0.08);
    transform: rotate(0.75deg);
  }

  .identity-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 22px -18px -18px 22px;
    border: 1px solid var(--line);
    background: var(--accent-soft);
  }

  .photo-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 0.92;
    background: #e9ece7;
  }

  .photo-wrap img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(0.84) contrast(1.02);
  }

  .photo-index {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 5px 8px;
    background: rgba(247, 247, 242, 0.92);
    color: var(--ink);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .identity-meta { padding: 18px 8px 8px; }
  .identity-name {
    color: var(--ink-strong);
    font-family: var(--serif);
    font-size: 28px;
    line-height: 1.1;
  }
  .identity-meta > p:not(.identity-name) {
    margin-top: 6px;
    color: var(--muted);
    font-size: 12px;
  }
  .identity-rule {
    height: 1px;
    margin: 18px 0 8px;
    background: var(--line);
  }
  .identity-row {
    padding: 9px 0;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--line);
    font-size: 11px;
  }
  .identity-row:last-child { border: 0; }
  .identity-row span { color: var(--faint); }
  .identity-row strong { color: var(--ink); font-weight: 620; text-align: right; }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.36);
  }

  .proof-item {
    min-height: 118px;
    padding: 24px 22px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .proof-item:last-child { border-right: 0; }
  .proof-item strong {
    color: var(--ink-strong);
    font-family: var(--serif);
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .proof-item span {
    max-width: 160px;
    margin-top: 8px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.45;
  }

  .section { padding: 118px 0 0; }
  .section-heading {
    margin-bottom: 44px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.65fr);
    gap: 70px;
    align-items: end;
  }

  .section-heading h2,
  .now-card h2,
  footer h2 {
    max-width: 700px;
    margin-top: 10px;
    font-family: var(--serif);
    color: var(--ink-strong);
    font-size: clamp(42px, 5vw, 66px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .section-intro {
    max-width: 420px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.72;
  }

  .trajectory-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line-strong);
    background: rgba(255,255,255,0.4);
  }

  .trajectory-card {
    min-height: 330px;
    padding: 24px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    transition: background 180ms ease, transform 180ms ease;
  }
