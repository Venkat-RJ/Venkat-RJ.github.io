---
import '@fontsource-variable/inter/index.css';
const jobs = [
  ['Sigmoid', 'Principal Data Scientist', 'Jun 2024 - May 2025', ['Built Data Companion, an enterprise Text2SQL accelerator using Claude on AWS Bedrock and Snowflake, achieving 90% query accuracy.', 'Built the winning GenAI recommendation prototype in a competitive client hackathon, helping secure a $1.5M contract.', 'Established the GenAI Center of Excellence and upskilled 50+ engineers.']],
  ['Samsung Research', 'Chief Data Scientist', 'Feb 2022 - Jul 2023', ['Led data scientists and PhD researchers working on Bixby intelligence, anomaly detection and out-of-domain requests.', 'Built systems connecting customer feedback with server logs to help developers identify root causes.', 'Co-inventor on Indian patent application 202341080390: System and Method for Determining Root Cause from User Feedback (filed 2023).']],
  ['Continental', 'Lead Data Scientist', 'Oct 2017 - Feb 2022', ['Built and led a 12-person data science team across industrial ML, optimization and supply-chain applications.', 'Reduced AntiPinch algorithm tuning from three weeks to 1.5 hours using Bayesian optimization.', 'Delivered entity deduplication, demand forecasting and supplier-selection systems.']],
];
const research = [
  ['CoherenceBench', 'Exploratory evaluation of decision coherence in long-running agents.', 'coherencebench'],
  ['FACET', 'Probes into how faithfully models explain multi-factor decisions.', 'facet-benchmark'],
  ['Razorpay for Claude Code', 'Open-source skills for checkout, subscriptions, webhooks and reconciliation.', 'razorpay-integration-plugin'],
  ['Autoresearch on Apple Silicon', 'An adaptation of the autoresearch workflow for MPS, CPU and CUDA.', 'autoresearch-mac-mini'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Venkateshwar Jambula | AI Engineering Leader, Researcher &amp; Founder</title>
  <meta name="description" content="AI engineering leader, researcher and founder with 15 years across safety-critical embedded systems, industrial ML, Samsung Bixby, enterprise GenAI and agent systems." />
  <link rel="icon" href="/favicon.svg" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header><a class="monogram" href="#main" aria-label="Venkateshwar Jambula home">VJ<span>.</span></a><nav aria-label="Main navigation"><a href="#experience">Experience</a><a href="#products">Products</a><a href="#research">Research</a><a href="#contact">Contact</a></nav></header>
  <main id="main">
    <section class="intro" aria-labelledby="name">
      <div class="identity"><img src="/headshot-src.jpg" width="88" height="104" alt="Venkateshwar Jambula" /><div><p class="location">Bengaluru, India</p><h1 id="name">Venkateshwar Jambula</h1><p class="role">AI engineering leader, researcher &amp; founder</p></div></div>
      <p class="summary">I build intelligent systems and the teams behind them. My 15-year path runs from safety-critical embedded software, optimization and industrial machine learning to Samsung Bixby, enterprise GenAI and founder-built agent systems. I care most about ambitious technical problems where reliability, research and real-world execution meet.</p>
      <div class="links"><a class="primary" href="mailto:venkateshwar.jambula@gmail.com">Get in touch</a><a href="https://www.linkedin.com/in/venkateshwar-jambula/" target="_blank" rel="noopener">LinkedIn ↗</a><a href="https://github.com/Venkat-RJ" target="_blank" rel="noopener">GitHub ↗</a></div>
      <p class="availability">Open to AI leadership, founding engineer and applied research opportunities.<br />Bengaluru-based roles or international relocation.</p>
    </section>
    <div class="proof" aria-label="Selected career outcomes"><div><strong>15 years</strong><span>Engineering experience</span></div><div><strong>12 people</strong><span>Team built at Continental</span></div><div><strong>$1.5M</strong><span>Client contract won at Sigmoid</span></div></div>
    <section id="experience">
      <h2>Industry experience</h2><p class="subtitle">Hands-on engineering and technical leadership.</p>
      {jobs.map(([company,role,dates,points]) => <article><div class="heading"><div><h3>{company}</h3><p class="muted">{role}</p></div><p class="date">{dates}</p></div><ul>{(points as string[]).map(point => <li>{point}</li>)}</ul></article>)}
      <div class="earlier"><h3>Earlier work</h3><div><strong>Founder, AI trading venture</strong><small>2023 - 2024</small><p>Broker integration, automated strategy deployment and risk-managed execution.</p></div><div><strong>Senior Embedded Systems Engineer, Caterpillar</strong><small>2015 - 2017</small><p>Computer vision for PCB inspection and genetic algorithms for injector optimization.</p></div><div><strong>Senior Software Engineer, Bosch</strong><small>2011 - 2015</small><p>Engine and exhaust control software, diagnostics and international project coordination.</p></div></div>
    </section>
    <section id="products">
      <h2>Founder work</h2><p class="subtitle">PranaAlpha Labs Pvt Ltd · Founder &amp; CEO · 2025 - 2026</p>
      <p class="context">As a solo founder, I owned product discovery, architecture, implementation and operations across multiple AI products and research prototypes. PranaAlpha is DPIIT-recognized and was selected for incubation at IIM Lucknow's Enterprise Incubation Centre.</p>
      <article><div class="heading"><div><h3>Lokaah</h3><p class="muted">Knowledge infrastructure for AI agents</p></div><p class="date">Research prototype · 2026</p></div><p>Built to connect people, companies and ownership across fragmented public records, with answers traceable back to their sources.</p><ul><li>Built ingestion and OCR pipelines, cross-source entity resolution, source-cited graph relationships, and MCP/REST interfaces.</li><li>Local US graph: 145,776 entities and 2,168,722 relationships. Public endpoint currently offline.</li></ul></article>
      <article><div class="heading"><div><h3>PortoAI</h3><p class="muted">Portfolio-aware AI companion</p></div><p class="date">Built &amp; operated · 2025 - 2026</p></div><p>Brought research, portfolio analysis, risk and trading workflows into one broker-connected product. Built and operated as a solo founder with real users.</p><ul><li>Designed 14 specialist agents with tool calling, persistent context, evaluations and safety guardrails.</li><li>Implemented approval-gated execution and owned the product from architecture through operations. The product is now closed.</li></ul></article>
      <details><summary>Other products and experiments <span aria-hidden="true">+</span></summary><div class="experiments"><h3>AI hedge-fund MVP</h3><p>Researcher, regime, risk-manager and trader agents deployed with proprietary capital. Instrumented memory failures, thesis inconsistency and strategy drift to guide evaluation.</p><h3>AdvisorsDesk</h3><p>Portfolio research and advisory workflows with compliance trails. The work exposed fragmented source data as a constraint and informed Lokaah.</p><h3>ZenTrader</h3><p>Broker-tradebook analysis for revenge trading and risk drift, readiness assessments, Claude coaching and market simulations with realistic costs.</p></div></details>
    </section>
    <section id="research"><h2>Research &amp; open source</h2><p class="subtitle">Current interests: agent reliability, formal verification, verifiable answers and evaluation.</p><div class="research-list">{research.map(([name,description,repo]) => <a href={`https://github.com/Venkat-RJ/${repo}`} target="_blank" rel="noopener"><div><h3>{name}</h3><p>{description}</p></div><span aria-hidden="true">↗</span></a>)}</div><p class="note">The benchmark projects are exploratory work, not peer-reviewed findings.</p></section>
    <footer id="contact"><h2>Let's talk.</h2><p>For AI leadership, founding engineer, applied research or research engineering roles.</p><a class="email" href="mailto:venkateshwar.jambula@gmail.com">venkateshwar.jambula@gmail.com</a><div class="footer-line"><span>Venkateshwar Jambula</span><span>Bengaluru, India</span></div></footer>
  </main>
</body>
</html>
<style is:global>
  :root{font-family:'Inter Variable',sans-serif;color:#242629;background:#fff;font-synthesis:none;--muted:#62676e;--line:#e1e4e7;--accent:#20694f}
  *{box-sizing:border-box;letter-spacing:0}html{scroll-behavior:smooth;scroll-padding-top:28px}body{margin:0;font-size:14px;line-height:1.7;-webkit-font-smoothing:antialiased}h1,h2,h3,p{margin:0}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline;text-underline-offset:4px}a:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:5px}h1{font-size:36px;line-height:1.2;font-weight:650}h2{font-size:23px;line-height:1.35;font-weight:650}h3{font-size:17px;line-height:1.4;font-weight:650}header,main{max-width:920px;margin:auto;padding-inline:32px}header{height:84px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.monogram{font-size:22px;font-weight:750}.monogram span{color:var(--accent)}nav{display:flex;gap:26px;font-size:13px;color:var(--muted)}.intro{padding:52px 0 32px}.identity{display:flex;align-items:center;gap:24px}.identity img{object-fit:cover;border-radius:4px;flex-shrink:0}.location{font-size:12px;color:var(--muted);margin-bottom:8px}.role{font-size:18px;margin-top:10px;color:var(--accent);font-weight:500}.summary{margin-top:26px;max-width:790px;font-size:16px;line-height:1.8}.links{display:flex;align-items:center;gap:26px;margin-top:25px;font-size:14px}.primary{background:#242629;color:white;padding:9px 15px;border-radius:4px}.availability{font-size:12px;color:var(--muted);margin-top:22px}.proof{display:grid;grid-template-columns:repeat(3,1fr);background:#f5f7f6;border-block:1px solid var(--line);padding:22px 0}.proof>div{padding:0 22px;border-left:1px solid var(--line)}.proof>div:first-child{border:0}.proof strong{display:block;font-size:23px;font-weight:650;line-height:1.3}.proof span{display:block;color:var(--muted);font-size:11px;margin-top:6px}main>section:not(.intro){padding-top:46px}.subtitle{font-size:13px;color:var(--muted);margin:7px 0 24px}article{padding:25px 0;border-top:1px solid var(--line)}.heading{display:flex;justify-content:space-between;gap:20px;margin-bottom:15px}.muted{font-size:13px;color:var(--muted);margin-top:4px}.date{font-size:12px;color:var(--muted);flex-shrink:0;padding-top:3px}ul{padding-left:19px;margin:12px 0 0}li{padding-left:3px;margin-bottom:7px}.earlier{border-top:1px solid var(--line);padding-top:22px}.earlier>div{margin-top:15px}.earlier p{font-size:13px;color:var(--muted)}.earlier small{margin-left:12px;color:var(--muted);font-size:11px}.context{margin-bottom:25px}details{border-block:1px solid var(--line)}summary{display:flex;justify-content:space-between;padding:16px 0;font-size:13px;cursor:pointer;list-style:none}summary::-webkit-details-marker{display:none}summary span{font-size:20px;line-height:1}details[open] summary span{transform:rotate(45deg)}.experiments{padding-bottom:22px}.experiments h3{font-size:14px;margin-top:14px}.experiments p{font-size:13px;color:var(--muted);margin-top:5px}.research-list a{display:flex;justify-content:space-between;gap:20px;padding:19px 0;border-top:1px solid var(--line)}.research-list h3{font-size:15px}.research-list p{font-size:13px;color:var(--muted);margin-top:5px}.research-list a>span{color:var(--accent)}.note{font-size:11px;color:var(--muted);margin-top:12px}footer{margin-top:48px;border-top:2px solid #242629;padding:30px 0 20px}footer>p{font-size:13px;color:var(--muted);margin-top:8px}.email{display:inline-block;margin-top:15px;color:var(--accent);font-size:15px;text-decoration:underline;text-underline-offset:4px;overflow-wrap:anywhere}.footer-line{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:40px}.skip{position:absolute;top:-80px}.skip:focus{top:10px;background:white;padding:10px;z-index:10}
  @media(max-width:650px){header,main{padding-inline:22px}header{height:68px}nav{gap:15px;font-size:11px}.intro{padding-top:30px}.identity{gap:16px;align-items:flex-start}.identity img{width:60px;height:74px}h1{font-size:25px}.role{font-size:15px}.location{font-size:11px;margin-bottom:5px}.summary{font-size:14px;margin-top:22px}.links{gap:20px;font-size:12px}.availability{font-size:11px}.proof>div{padding:0 12px}.proof strong{font-size:19px}.proof span{font-size:10px}.proof>div:first-child{padding-left:10px}.heading{display:block}.date{margin-top:6px}.earlier small{display:block;margin:3px 0}h2{font-size:21px}main>section:not(.intro){padding-top:36px}.email{font-size:13px}}
  @media(max-width:360px){header,main{padding-inline:16px}nav{gap:12px}h1{font-size:22px}.identity{gap:12px}.proof strong{font-size:17px}.links{gap:16px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
